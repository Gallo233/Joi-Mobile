{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.joi.local/journey-context-snapshot-v1.schema.json",
  "title": "JourneyContextSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["sourceRevisionIDs", "consentScope"],
  "properties": {
    "journeyID": { "type": ["string", "null"] },
    "placeID": { "type": ["string", "null"] },
    "routeID": { "type": ["string", "null"] },
    "stopID": { "type": ["string", "null"] },
    "coordinate": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "horizontalAccuracyMeters": { "type": ["number", "null"], "minimum": 0 },
    "observedAt": { "type": ["string", "null"], "format": "date-time" },
    "routeProgress": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "identityConfidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "sourceRevisionIDs": { "type": "array", "items": { "type": "string" } },
    "consentScope": { "enum": ["ephemeral", "chatOneTurn"] }
  }
}
