{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.joi.local/character-package-manifest-v1.schema.json",
  "title": "CharacterPackageManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "packageID", "characterID", "version", "displayName", "renderer", "entryPath", "locales", "assets", "provenance"],
  "properties": {
    "schema": { "const": "joi.character.v1" },
    "packageID": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "characterID": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 80 },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 160 },
    "renderer": { "enum": ["static", "live2d", "vrm"] },
    "entryPath": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
    "portraitPath": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" }
      ]
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["zh-Hans", "zh-Hant", "en", "ja", "ko"] }
    },
    "motions": {
      "description": "Semantic motion name to declared VRMA asset. Only a vrm package may declare this; a .vrm file itself carries no animation (DEC-024).",
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["motion", "animation"],
        "properties": {
          "motion": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9_-]*$" },
          "animation": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+\\.vrma$" },
          "loop": { "type": "boolean" }
        }
      }
    },
    "assets": {
      "description": "Every file the package declares. `maxItems` is the same number as CharacterPackageLimits.maximumFileCount / MAXIMUM_FILE_COUNT and the restricted-ZIP file-count gate, and the forbidden-content walk's generic 300-element array bound is not applied to this one array (DEC-028). A second bound the schema cannot express: the manifest document is read under a 1 MiB cap, which is what refuses a list of 2000 assets whose paths all approach the 512-character maximum.",
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mediaType", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
          "mediaType": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9.+-]*/[a-z0-9][a-z0-9.+-]*$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "license"],
      "properties": {
        "author": { "type": "string", "minLength": 1, "maxLength": 500 },
        "license": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "source": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "format": "uri",
              "pattern": "^https://"
            }
          ]
        }
      }
    }
  }
}
