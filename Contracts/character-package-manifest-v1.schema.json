{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.joi.local/character-package-manifest-v1.schema.json",
  "title": "CharacterPackageManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "packageID", "characterID", "version", "displayName", "renderer", "entryPath", "locales", "assets", "provenance"],
  "properties": {
    "schema": { "const": "joi.character.v1" },
    "packageID": { "type": "string", "minLength": 1 },
    "characterID": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "renderer": { "enum": ["static", "live2d", "vrm"] },
    "entryPath": { "type": "string", "minLength": 1 },
    "portraitPath": { "type": ["string", "null"] },
    "locales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["zh-Hans", "zh-Hant", "en", "ja", "ko"] }
    },
    "assets": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mediaType", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "mediaType": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "license"],
      "properties": {
        "author": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "source": { "type": ["string", "null"] }
      }
    }
  }
}
