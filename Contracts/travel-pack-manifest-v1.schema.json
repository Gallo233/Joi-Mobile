{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.joi.local/travel-pack-manifest-v1.schema.json",
  "title": "TravelPackManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "packID", "routeID", "version", "locales", "routePath", "files", "sourceRevisionIDs", "rights", "createdAt"],
  "properties": {
    "schema": { "const": "joi.travel-pack.v1" },
    "packID": { "type": "string", "minLength": 1 },
    "routeID": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "locales": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["zh-Hans", "zh-Hant", "en", "ja", "ko"] } },
    "routePath": { "type": "string", "minLength": 1 },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "mediaType"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "mediaType": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sourceRevisionIDs": { "type": "array", "items": { "type": "string" } },
    "rights": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": ["string", "null"], "format": "date-time" }
  }
}
